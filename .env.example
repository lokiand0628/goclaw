# =============================================================================
# ClawdBot 配置 - 多 LLM 支持版本
# 将此文件复制为 .env 并填写你的配置值。
# =============================================================================

# ---------------------------------------------------------------------------
# 核心设置
# ---------------------------------------------------------------------------
CLAWDBOT_WORKSPACE=./workspace
CLAWDBOT_DB=./clawdbot.db
CLAWDBOT_CONCURRENCY=4
CLAWDBOT_BACKUP_ENABLED=true
CLAWDBOT_BACKUP_MAX_VERSIONS=5

# 可选：危险操作免确认（开发模式）
# CLAWDBOT_SKIP_CONFIRMATION=false

# ---------------------------------------------------------------------------
# LLM 提供商配置（支持任意数量，使用 PROVIDER_<名称>_API_KEY 格式）
# 至少配置一个，程序启动时会自动加载所有以 PROVIDER_ 开头的配置
# ---------------------------------------------------------------------------

# 默认使用的 provider（不设置则使用第一个配置的）
# DEFAULT_PROVIDER=claude

# --- 示例 1: Anthropic Claude ---
# PROVIDER_CLAUDE_API_KEY=sk-ant-api03-xxx
# PROVIDER_CLAUDE_BASE_URL=https://api.anthropic.com
# PROVIDER_CLAUDE_MODEL=claude-3-5-sonnet-latest
# PROVIDER_CLAUDE_TYPE=anthropic
# PROVIDER_CLAUDE_CONTEXT=160000

# --- 示例 2: MiniMax M2.5 ---
# PROVIDER_MINIMAX_API_KEY=eyxxx
# PROVIDER_MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
# PROVIDER_MINIMAX_MODEL=MiniMax-M2.5
# PROVIDER_MINIMAX_TYPE=anthropic
# PROVIDER_MINIMAX_CONTEXT=800000

# --- 示例 3: DeepSeek ---
# PROVIDER_DEEPSEEK_API_KEY=sk-xxx
# PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# PROVIDER_DEEPSEEK_MODEL=deepseek-chat
# PROVIDER_DEEPSEEK_TYPE=openai
# PROVIDER_DEEPSEEK_CONTEXT=65536

# --- 示例 4: OpenAI ---
# PROVIDER_OPENAI_API_KEY=sk-xxx
# PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
# PROVIDER_OPENAI_MODEL=gpt-4o
# PROVIDER_OPENAI_TYPE=openai
# PROVIDER_OPENAI_CONTEXT=100000

# --- 示例 5: Aliyun Bailian (Qwen) ---
# PROVIDER_QWEN_API_KEY=sk-xxx
# PROVIDER_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PROVIDER_QWEN_MODEL=qwen-max
# PROVIDER_QWEN_TYPE=openai # or anthropic if using that endpoint
# PROVIDER_QWEN_CONTEXT=32000

# --- 示例 6: Moonshot (Kimi) ---
# PROVIDER_KIMI_API_KEY=sk-xxx
# PROVIDER_KIMI_BASE_URL=https://api.moonshot.cn/v1
# PROVIDER_KIMI_MODEL=moonshot-v1-8k
# PROVIDER_KIMI_TYPE=openai
# PROVIDER_KIMI_CONTEXT=8000

# --- 简化配置：直接使用标准环境变量 (适用于单 Provider 场景) ---
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-proj-xxx
#
# 注意：如果设置了上述环境变量，且未配置特定的 PROVIDER_*，程序将自动使用它们。
# 但为了更精细的控制（如同时使用多个 Provider），建议使用上面的 PROVIDER_* 格式。

# ---------------------------------------------------------------------------
# 渠道配置（取消注释以启用）
# ---------------------------------------------------------------------------

# --- 飞书 ---
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_DOMAIN=feishu

# --- Telegram ---
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_ALLOWED_USERS=your_username

# --- 钉钉 ---
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
# DINGTALK_ROBOT_TOKEN=

# --- 企业微信 ---
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_SECRET=

# ---------------------------------------------------------------------------
# 心跳检测
# ---------------------------------------------------------------------------
# CLAWDBOT_HEARTBEAT_INTERVAL=30
# CLAWDBOT_HEARTBEAT_ADMIN_CHAT_ID=
